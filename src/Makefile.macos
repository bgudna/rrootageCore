# rRootage makefile for macOS
# Requires: Xcode command line tools, Homebrew `sdl2`, `sdl2_mixer` and `libopenmpt`.
# libbulletml is built from source automatically.
#
#   brew install sdl2 sdl2_mixer libopenmpt pkgconf
#   make -f Makefile.macos

NAME   = rr
O      = o
RM     = rm -f
CC     = clang
CXX    = clang++

PROG   = $(NAME)

BULLETML_VER = 0.0.6
BULLETML_URL = http://shinh.skr.jp/libbulletml/libbulletml-$(BULLETML_VER).tar.bz2
BULLETML_LIB = ./libbulletml_macos.a
BULLETML_SRC = bulletml_build/bulletml/src
BULLETML_SRCS = bulletmlparser-tinyxml bulletmlparser bulletmltree calc formula-variables \
	bulletmlrunner bulletmlrunnerimpl tinyxml/tinyxml tinyxml/tinyxmlparser tinyxml/tinyxmlerror

OPENMPT_CFLAGS := $(shell pkg-config --cflags libopenmpt 2>/dev/null || echo -I/opt/homebrew/include)
OPENMPT_LIBS   := $(shell pkg-config --libs libopenmpt 2>/dev/null || echo -L/opt/homebrew/lib -lopenmpt)

DEFAULT_CFLAGS = $(shell sdl2-config --cflags) $(OPENMPT_CFLAGS)
LDFLAGS        = $(BULLETML_LIB) $(shell sdl2-config --libs) -lSDL2_mixer $(OPENMPT_LIBS) -framework OpenGL

MORE_CFLAGS = -O2 -Wall -Wno-deprecated-declarations

CFLAGS   = $(DEFAULT_CFLAGS) $(MORE_CFLAGS)
CXXFLAGS = $(DEFAULT_CFLAGS) $(MORE_CFLAGS) -I./bulletml/

# Asset pack (rr.dat), loaded by the game from the directory of the executable.
PACKER     = packer
PACK       = ../bin/$(NAME).dat
ASSET_DIRS = images sounds normal reversible morph simple morph_heavy psy
ASSETS     = $(wildcard $(addprefix ../,$(addsuffix /*,$(ASSET_DIRS))))

OBJS =	$(NAME).$(O) \
	foe.$(O) foecommand.$(O) barragemanager.$(O) boss.$(O) ship.$(O) laser.$(O) \
	frag.$(O) background.$(O) letterrender.$(O) shot.$(O) \
	screen.$(O) vector.$(O) degutil.$(O) rand.$(O) mt19937int.$(O) \
	soundmanager.$(O) attractmanager.$(O) pack.$(O)

all: $(PROG) $(PACK)

$(PROG): $(OBJS) $(BULLETML_LIB)
	$(CXX) -o $(PROG) $(OBJS) $(LDFLAGS)
	mkdir -p ../bin
	mv $(PROG) ../bin

$(BULLETML_LIB):
	mkdir -p bulletml_build
	curl -L -o bulletml_build/libbulletml.tar.bz2 $(BULLETML_URL)
	tar xjf bulletml_build/libbulletml.tar.bz2 -C bulletml_build
	cd $(BULLETML_SRC) && for f in $(BULLETML_SRCS); do \
	  $(CXX) -std=c++98 -O2 -w -include cstring -include cstdlib -I. -c $$f.cpp -o $$(basename $$f).o || exit 1; done
	$(AR) rcs $(BULLETML_LIB) $(BULLETML_SRC)/*.o

$(PACKER): packer.c
	$(CC) -O2 -Wall -o $(PACKER) packer.c

$(PACK): $(PACKER) $(ASSETS)
	mkdir -p ../bin
	cd .. && src/$(PACKER) bin/$(NAME).dat $(ASSET_DIRS)

.PHONY: all clean

clean:
	$(RM) ../bin/$(PROG) $(PACK) $(PACKER) *.$(O)
	rm -rf bulletml_build $(BULLETML_LIB)
